# AgenticCP-Core 환경변수 예시 파일
# 실제 사용 시 .env 파일로 복사하여 사용하세요
# ⚠️ 중요: .env 파일은 절대 Git에 커밋하지 마세요! (.gitignore에 포함되어 있음)

# ============================================
# 데이터베이스 설정
# ============================================
DATABASE_URL=jdbc:mysql://localhost:3306/agenticcp?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=agenticcp
DATABASE_PASSWORD=your_secure_password_here

# ============================================
# JWT 설정 (⚠️ 보안: 프로덕션에서는 반드시 강력한 시크릿 사용)
# ============================================
# JWT_SECRET은 Base64로 인코딩된 최소 32바이트(256비트) 이상의 랜덤 문자열이어야 합니다.
# 생성 방법 예시:
#   - Linux/Mac: openssl rand -base64 32
#   - 또는: openssl rand -hex 32 | base64
# ⚠️ 개발 환경과 프로덕션 환경에서 서로 다른 값 사용 필수!
JWT_SECRET=your_base64_encoded_jwt_secret_here_must_be_at_least_32_bytes
JWT_ACCESS_EXP_MS=3600000
JWT_REFRESH_EXP_MS=604800000

# ============================================
# Redis 설정
# ============================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
APP_REDIS_ENABLED=false

# ============================================
# 암호화 설정 (⚠️ 보안: 프로덕션에서는 반드시 강력한 키 사용)
# ============================================
# CONFIG_CIPHER_KEY는 AES-256 암호화에 사용됩니다.
# Base64로 인코딩된 32바이트(256비트) 키가 필요합니다.
# 생성 방법 예시:
#   - Linux/Mac: openssl rand -base64 32
# ⚠️ 개발 환경과 프로덕션 환경에서 서로 다른 값 사용 필수!
CONFIG_CIPHER_KEY=your_base64_encoded_cipher_key_here_must_be_32_bytes

# ============================================
# Spring 프로파일
# ============================================
SPRING_PROFILES_ACTIVE=local

# ============================================
# Docker Compose 사용 시 참고
# ============================================
# docker-compose.yml과 docker-compose.dev.yml은 .env 파일을 자동으로 로드합니다.
# 이 파일을 .env로 복사하고 적절한 값을 설정한 후 docker-compose를 실행하세요.
